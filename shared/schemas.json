{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestionRequest",
  "type": "object",
  "properties": {
    "question": { "type": "string" },
    "sessionId": { "type": "string" },
    "conversationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "type": "string" }
        },
        "required": ["role", "content"]
      }
    }
  },
  "required": ["question"]
}
