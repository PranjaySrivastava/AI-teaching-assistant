{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TeachingAssistantSchemas",
  "definitions": {
    "QuestionRequest": {
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "sessionId": { "type": "string" },
        "conversationHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant"] },
              "content": { "type": "string" }
            },
            "required": ["role", "content"]
          }
        }
      },
      "required": ["question"]
    },
    "VisualizationStep": {
      "type": "object",
      "properties": {
        "step": { "type": "integer" },
        "description": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["compare", "swap", "highlight", "traverse", "insert", "delete", "visit", "relax"]
        },
        "indices": { "type": "array", "items": { "type": "integer" } },
        "values": { "type": "array" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "activeLines": { "type": "array", "items": { "type": "integer" } }
      },
      "required": ["step", "action", "description"]
    },
    "QuestionResponse": {
      "type": "object",
      "properties": {
        "explanation": { "type": "string" },
        "answer": { "type": "string" },
        "mood": {
          "type": "string",
          "enum": ["explaining", "thinking", "encouraging", "celebrating", "idle"]
        },
        "code": {
          "type": "object",
          "properties": {
            "language": { "type": "string", "enum": ["python", "javascript", "java", "cpp"] },
            "snippet": { "type": "string" },
            "activeLines": { "type": "array", "items": { "type": "integer" } }
          },
          "required": ["language", "snippet"]
        },
        "visualSequence": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["tree", "graph", "sorting", "array", "dp", "algorithm_visualization"]
            },
            "title": { "type": "string" },
            "steps": {
              "type": "array",
              "items": { "$ref": "#/definitions/VisualizationStep" }
            }
          },
          "required": ["type", "title", "steps"]
        },
        "suggestedFollowUps": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["mood"]
    }
  }
}
