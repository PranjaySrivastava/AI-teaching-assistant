{
  "_comment": "Full phoneme-to-viseme mapping and sentiment blendshape weights for Three.js avatar. Designed for ARKit 52-blendshape face model.",

  "sentiments": {
    "idle": {
      "_description": "Neutral resting pose — used between responses",
      "eye_gaze": "forward",
      "head_tilt_degrees": 0.0,
      "blink_rate_per_minute": 15,
      "blendshape_weights": {
        "mouthClose": 1.0,
        "eyeBlinkLeft": 0.05,
        "eyeBlinkRight": 0.05
      },
      "gesture_animation": "idle_breathing"
    },
    "thinking": {
      "_description": "Professor Ada working through a complex derivation",
      "eye_gaze": "up_left",
      "head_tilt_degrees": 5.0,
      "blink_rate_per_minute": 8,
      "blendshape_weights": {
        "browInnerUp": 0.4,
        "browDownLeft": 0.1,
        "browDownRight": 0.1,
        "mouthPucker": 0.2,
        "mouthStretchLeft": 0.1,
        "mouthStretchRight": 0.1,
        "eyeLookUpLeft": 0.3,
        "eyeLookUpRight": 0.3,
        "eyeLookOutLeft": 0.2,
        "eyeLookInRight": 0.2
      },
      "gesture_animation": "chin_stroke"
    },
    "explaining": {
      "_description": "Default active teaching mode",
      "eye_gaze": "direct",
      "head_tilt_degrees": 0.0,
      "blink_rate_per_minute": 12,
      "blendshape_weights": {
        "browOuterUpLeft": 0.2,
        "browOuterUpRight": 0.2,
        "mouthSmileLeft": 0.15,
        "mouthSmileRight": 0.15,
        "eyeWideLeft": 0.1,
        "eyeWideRight": 0.1
      },
      "gesture_animation": "forward_lean"
    },
    "encouraging": {
      "_description": "Praising or motivating the student",
      "eye_gaze": "direct",
      "head_tilt_degrees": -3.0,
      "blink_rate_per_minute": 10,
      "blendshape_weights": {
        "mouthSmileLeft": 0.6,
        "mouthSmileRight": 0.6,
        "eyeWideLeft": 0.2,
        "eyeWideRight": 0.2,
        "cheekSquintLeft": 0.3,
        "cheekSquintRight": 0.3,
        "browInnerUp": 0.15
      },
      "gesture_animation": "nod_slow"
    },
    "celebrating": {
      "_description": "Student got it right — full celebration expression",
      "eye_gaze": "direct",
      "head_tilt_degrees": -5.0,
      "blink_rate_per_minute": 5,
      "blendshape_weights": {
        "mouthSmileLeft": 0.9,
        "mouthSmileRight": 0.9,
        "eyeWideLeft": 0.5,
        "eyeWideRight": 0.5,
        "cheekSquintLeft": 0.6,
        "cheekSquintRight": 0.6,
        "browInnerUp": 0.4,
        "browOuterUpLeft": 0.35,
        "browOuterUpRight": 0.35,
        "mouthOpen": 0.25,
        "jawOpen": 0.2
      },
      "gesture_animation": "clap_hands"
    }
  },

